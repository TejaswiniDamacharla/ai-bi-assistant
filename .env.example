# Copy this file to ".env" and fill in your key. NEVER commit .env to GitHub.
# Leave LLM_PROVIDER=none to run with the rule-based interpreter only.

# --- Option A: Google Gemini (free tier at https://aistudio.google.com/apikey) ---
LLM_PROVIDER=gemini
LLM_API_KEY=paste-your-key-here
LLM_MODEL=gemini-3.5-flash

# --- Option B: any OpenAI-compatible API, e.g. Groq (free tier at https://console.groq.com) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=paste-your-key-here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
